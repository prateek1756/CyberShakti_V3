# CyberShakti Backend Environment Configuration Template
ENVIRONMENT=dev
DEBUG=true
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://cybershakti_user:dev_password@localhost:5432/cybershakti_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & JWT
JWT_SECRET_KEY=dev_secret_key_change_in_production_0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate limiting (interim defaults — ADR-026)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_UPLOAD_BYTES=10485760

# External Integrations (Placeholders for local dev)
THREAT_INTEL_API_KEY=dev_threat_intel_key_placeholder
LLM_API_KEY=dev_llm_key_placeholder

# Storage (S3 / Local Mock)
S3_BUCKET_NAME=cybershakti-storage-dev
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=dev_access_key
S3_SECRET_ACCESS_KEY=dev_secret_key
